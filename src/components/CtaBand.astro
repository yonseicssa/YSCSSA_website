---
interface Props {
  title: string;
  description?: string;
}

const { title, description } = Astro.props;
---

<section class="cta-band">
  <div class="container">
    <div class="cta-band-inner">
      <h2>{title}</h2>
      {description && <p>{description}</p>}
      <div class="cta-band-actions">
        <slot />
      </div>
    </div>
  </div>
</section>
