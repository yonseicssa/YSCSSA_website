---
import { formatDateRange } from '../lib/date';
import { effectiveEnd, statusOf, type EventEntry } from '../lib/events';
import { imageUrl } from '../lib/images';
import { localePath, t, type Lang } from '../i18n/ui';
import Icon from './Icon.astro';

interface Props {
  event: EventEntry;
  slug: string;
  lang: Lang;
  featured?: boolean;
  eager?: boolean;
}

const { event, slug, lang, featured = false, eager = false } = Astro.props;
const { title, startDate, endDate, location, cover, coverAlt, pinned } = event.data;

// 构建时先给一个初始值，页面打开后由脚本按当前时间重算（PRD 4.3）
const initialStatus = statusOf(event);
const href = localePath(lang, `/events/${slug}`);
---

<article class={`activity-card${featured ? ' featured' : ''}`} data-event-card data-status={initialStatus}>
  <div class="activity-media">
    <img
      class="activity-image activity-image-media"
      src={imageUrl(cover)}
      alt={coverAlt}
      loading={eager ? 'eager' : 'lazy'}
      decoding="async"
      width="1600"
      height="900"
    />
    {pinned && <span class="chip chip-accent chip-pinned">{t(lang, 'events.pinned')}</span>}
    <span
      class={`event-status chip-status status-${initialStatus}`}
      data-event-end={effectiveEnd(event).toISOString()}
      data-label-upcoming={t(lang, 'events.upcoming')}
      data-label-ended={t(lang, 'events.ended')}
    >
      {t(lang, initialStatus === 'upcoming' ? 'events.upcoming' : 'events.ended')}
    </span>
  </div>

  <div class="activity-content">
    <h3><a href={href}>{title}</a></h3>

    <div class="activity-meta">
      <span>
        <Icon name="calendar" />
        <time datetime={startDate.toISOString()}>{formatDateRange(startDate, endDate, lang)}</time>
      </span>
      <span>
        <Icon name="location" />
        {location}
      </span>
    </div>
  </div>
</article>
