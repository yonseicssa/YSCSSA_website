---
interface Props {
  title: string;
  subtitle?: string;
  eyebrow?: string;
}

const { title, subtitle, eyebrow } = Astro.props;
---

<header class="page-header">
  <div class="page-header-inner">
    {eyebrow && <p class="page-header-eyebrow">{eyebrow}</p>}
    <h1>{title}</h1>
    {subtitle && <p>{subtitle}</p>}
  </div>
</header>
