---
import { imageUrl } from '../lib/images';
import { t, type Lang } from '../i18n/ui';
import { settings } from '../lib/settings';
import Icon from './Icon.astro';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
---

<section class="section section-alt" aria-labelledby="platforms-title">
  <div class="container">
    <h2 class="section-title" id="platforms-title">{t(lang, 'home.platforms')}</h2>
    <p class="section-subtitle">{t(lang, 'home.platformsIntro')}</p>

    <div class="platform-grid">
      <a class="platform-card" href={settings.xiaohongshu} target="_blank" rel="noopener noreferrer">
        <span class="platform-icon" aria-hidden="true"><Icon name="book" /></span>
        <div>
          <p class="platform-name">小红书</p>
          <p class="platform-hint">@YSCSSA</p>
        </div>
        <Icon name="external" class="platform-go" />
      </a>

      <a class="platform-card" href={settings.instagram} target="_blank" rel="noopener noreferrer">
        <span class="platform-icon" aria-hidden="true"><Icon name="camera" /></span>
        <div>
          <p class="platform-name">Instagram</p>
          <p class="platform-hint">@yscssa</p>
        </div>
        <Icon name="external" class="platform-go" />
      </a>

      <!-- 公众号无法通过网页链接跳转，因此以二维码呈现（PRD 4.1 / 6.4） -->
      <div class="platform-card platform-card-qr">
        <button type="button" class="qr-button" data-qr-open aria-label={t(lang, 'home.wechatHint')}>
          <img
            src={imageUrl(settings.wechatQr)}
            alt={`${settings.wechatName} 微信公众号二维码`}
            width="120"
            height="120"
            loading="lazy"
          />
        </button>
        <div>
          <p class="platform-name">微信公众号</p>
          <p class="platform-hint">{settings.wechatName}</p>
          <p class="platform-hint">{t(lang, 'home.wechatHint')}</p>
        </div>
      </div>
    </div>
  </div>
</section>

<dialog class="qr-dialog" data-qr-dialog>
  <img src={imageUrl(settings.wechatQr)} alt={`${settings.wechatName} 微信公众号二维码`} width="480" height="480" />
  <form method="dialog">
    <button class="cta-button cta-button-outline" type="submit">{lang === 'zh' ? '关闭' : '닫기'}</button>
  </form>
</dialog>

<script>
  const dialog = document.querySelector<HTMLDialogElement>('[data-qr-dialog]');
  document.querySelector<HTMLButtonElement>('[data-qr-open]')?.addEventListener('click', () => dialog?.showModal());
  dialog?.addEventListener('click', (event) => {
    if (event.target === dialog) dialog.close();
  });
</script>
