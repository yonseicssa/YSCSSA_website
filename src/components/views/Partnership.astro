---
import { getEntry, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { t, type Lang } from '../../i18n/ui';
import { settings } from '../../lib/settings';
import Icon from '../Icon.astro';
import PageHeader from '../PageHeader.astro';
import CtaBand from '../CtaBand.astro';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const page = (await getEntry('pages', `${lang}/partnership`))!;
const { Content } = await render(page);
---

<Base lang={lang} path="/partnership" title={page.data.seoTitle} description={page.data.seoDescription}>
  <PageHeader title={page.data.heading} subtitle={page.data.subheading} />

  <section class="container section">
    <div class="prose">
      <Content />
    </div>

  </section>

  <CtaBand title={t(lang, 'partnership.ctaTitle')} description={t(lang, 'partnership.ctaBody')}>
    <a class="cta-button cta-button-onDark" href={`mailto:${settings.email}`}>
      {settings.email}
      <Icon name="mail" />
    </a>
  </CtaBand>
</Base>
