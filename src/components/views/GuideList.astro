---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { effectiveUpdated, orderedGuides } from '../../lib/guides';
import { localePath, t, type Lang } from '../../i18n/ui';
import Icon from '../Icon.astro';
import PageHeader from '../PageHeader.astro';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const guides = orderedGuides(await getCollection('guides'));
---

<Base
  lang={lang}
  path="/guide"
  title={`${t(lang, 'guide.title')} - ${t(lang, 'site.fullName')}`}
  description={t(lang, 'guide.intro')}
>
  <PageHeader title={t(lang, 'guide.title')} subtitle={t(lang, 'guide.intro')} />

  <section class="container section">
    <form class="guide-search" role="search" onsubmit="return false">
      <label class="visually-hidden" for="guide-search-input">{t(lang, 'guide.search')}</label>
      <Icon name="search" />
      <input
        id="guide-search-input"
        type="search"
        autocomplete="off"
        placeholder={t(lang, 'guide.searchPlaceholder')}
        data-guide-search
      />
    </form>

    {
      guides.length === 0 ? (
        <p class="empty-state">{t(lang, 'guide.empty')}</p>
      ) : (
        <ul class="guide-list" data-guide-list>
          {guides.map((guide) => (
            <li class="guide-item" data-slug={guide.data.slug}>
              <a href={localePath(lang, `/guide/${guide.data.slug}`)}>
                <span class="guide-date">
                  <span class="visually-hidden">{t(lang, 'guide.updated')}</span>
                  <span class="guide-date-year">{effectiveUpdated(guide).getFullYear()}</span>
                  <span class="guide-date-month">
                    {lang === 'zh'
                      ? `${effectiveUpdated(guide).getMonth() + 1} 月`
                      : `${effectiveUpdated(guide).getMonth() + 1}월`}
                  </span>
                </span>

                <span class="guide-body">
                  <span class="guide-title">{guide.data.title}</span>
                  <span class="guide-summary">{guide.data.summary}</span>
                </span>

                <Icon name="arrow-forward" class="guide-go" />
              </a>
            </li>
          ))}
        </ul>
      )
    }

    <p class="empty-state" data-guide-empty hidden>{t(lang, 'guide.noResult')}</p>
  </section>
</Base>

<script>
  const input = document.querySelector<HTMLInputElement>('[data-guide-search]');
  const list = document.querySelector<HTMLElement>('[data-guide-list]');
  const empty = document.querySelector<HTMLElement>('[data-guide-empty]');

  type IndexItem = { slug: string; title: string; summary: string; text: string };
  let index: IndexItem[] | null = null;

  async function loadIndex(): Promise<IndexItem[]> {
    if (index) return index;
    const response = await fetch('/guide-index.json');
    index = (await response.json()) as IndexItem[];
    return index;
  }

  async function run(query: string) {
    if (!list) return;
    const items = Array.from(list.querySelectorAll<HTMLElement>('.guide-item'));
    const keywords = query.trim().toLowerCase().split(/\s+/).filter(Boolean);

    if (keywords.length === 0) {
      items.forEach((item) => (item.hidden = false));
      if (empty) empty.hidden = true;
      return;
    }

    const data = await loadIndex();
    // 子串匹配，不依赖分词：搜索「登录证」一定能命中正文中的「登录证」
    const matched = new Set(
      data
        .filter((entry) => {
          const haystack = `${entry.title} ${entry.summary} ${entry.text}`.toLowerCase();
          return keywords.every((keyword) => haystack.includes(keyword));
        })
        .map((entry) => entry.slug)
    );

    let visible = 0;
    items.forEach((item) => {
      const hit = matched.has(item.dataset.slug ?? '');
      item.hidden = !hit;
      if (hit) visible += 1;
    });
    if (empty) empty.hidden = visible > 0;
  }

  input?.addEventListener('input', () => void run(input.value));
</script>
