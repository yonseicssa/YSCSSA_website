---
import { getCollection } from 'astro:content';
import EventDetail from '../../components/views/EventDetail.astro';
import { buildSlugMap } from '../../lib/events';

export async function getStaticPaths() {
  const events = await getCollection('events');
  const slugs = buildSlugMap(events);
  return events.map((event) => ({
    params: { slug: slugs.get(event.id)! },
    props: { event, slug: slugs.get(event.id)! }
  }));
}

const { event, slug } = Astro.props;
---
<EventDetail lang="zh" event={event} slug={slug} />
