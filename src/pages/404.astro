---
import Base from '../layouts/Base.astro';
import { t } from '../i18n/ui';
---

<Base lang="zh" path="/404" title={t('zh', 'notFound.title')} description={t('zh', 'notFound.body')} noindex bare>
  <section class="notfound">
    <div class="container">
      <p class="notfound-code">404</p>

      <div data-nf-lang="zh">
        <h1>{t('zh', 'notFound.title')}</h1>
        <p class="lead">{t('zh', 'notFound.body')}</p>
        <a class="cta-button" href="/" data-nf-home>{t('zh', 'notFound.home')}</a>
      </div>

      <div data-nf-lang="ko" hidden>
        <h1>{t('ko', 'notFound.title')}</h1>
        <p class="lead">{t('ko', 'notFound.body')}</p>
        <a class="cta-button" href="/ko" data-nf-home>{t('ko', 'notFound.home')}</a>
      </div>
    </div>
  </section>
</Base>

<script>
  // 按访问路径的语言前缀决定显示哪一版（PRD 4.6）
  const isKorean = location.pathname === '/ko' || location.pathname.startsWith('/ko/');
  document.documentElement.lang = isKorean ? 'ko' : 'zh';
  document.querySelectorAll<HTMLElement>('[data-nf-lang]').forEach((block) => {
    block.hidden = block.dataset.nfLang !== (isKorean ? 'ko' : 'zh');
  });
</script>
