---
import { getCollection } from 'astro:content';
import EventsList, { PER_PAGE } from '../../../../components/views/EventsList.astro';

export async function getStaticPaths() {
  const total = Math.ceil((await getCollection('events')).length / PER_PAGE);
  return Array.from({ length: Math.max(0, total - 1) }, (_, i) => ({
    params: { page: String(i + 2) }
  }));
}

const pageNum = Number(Astro.params.page);
---
<EventsList lang="ko" pageNum={pageNum} />
